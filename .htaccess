# lanxingqingxi.com — .htaccess
# Last updated: 2026-07-19

# GZIP compression for sitemap and text files
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/xml application/xml+rss
  # Force gzip for sitemap
  <FilesMatch "sitemap\.xml$">
    ForceType application/xml
  </FilesMatch>
</IfModule>

RewriteEngine On
# ─── Crawler Access Log ───
SetEnvIfNoCase User-Agent "bot|crawler|spider|scraper|slurp|scan|agent|fetch|extract|download" is_crawler
SetEnvIfNoCase User-Agent "google|bing|baidu|yandex|duckduck|sogou|360|yisou|shenma|toutiao" is_crawler
SetEnvIfNoCase User-Agent "GPTBot|CCBot|Bytespider|DeepSeek|KimiBot|Yuanbao|Perplexity|anthropic|Claude|Applebot|Meta-External|Aliyun|Firecrawl|TwinAgent|ChatGPT|Doubao|Omgili|cohere|Amazonbot|NovaAct|openai|crawl4ai" is_crawler
SetEnvIfNoCase User-Agent "Ahrefs|Semrush|MJ12|DotBot|Majestic" is_crawler

CustomLog /home/u527534732/.logs/crawler.log combined env=is_crawler


# ─── Security headers ───
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "upgrade-insecure-requests; script-src 'self' 'unsafe-inline' https://hm.baidu.com https://zz.bdstatic.com https://www.googletagmanager.com https://*.google-analytics.com https://www.googletagmanager.com/gtag/js; object-src 'none'"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png|gif|svg|ico|css|js|woff2?)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>

</IfModule>

# ─── index.html → / (canonical root, prevent duplicate content) ───
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^index\.php$ / [R=301,L]
RewriteRule ^en/index\.html$ /en/ [R=301,L]

# ─── non-www → www ───
RewriteCond %{HTTP_HOST} ^lanxingqingxi\.com$ [NC]
RewriteRule ^(.*)$ https://www.lanxingqingxi.com/$1 [R=301,L]

# ─── HTTP → HTTPS ───
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# --- /.well-known/llms.txt -> /llms.txt (2026-09-07, standard route) ---
RewriteRule ^\.well-known/llms\.txt$ /llms.txt [R=301,L]


# ─── Old WP slugs → correct .html pages (2026-07-30 CC fix) ───
