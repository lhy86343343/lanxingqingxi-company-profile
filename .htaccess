# ─── WordPress residuals → 410 Gone ───
RewriteRule ^wp- - [R=410,L]
RewriteRule ^wp($|/) - [R=410,L]
RewriteRule ^wordpress($|/) - [R=410,L]
RewriteRule ^xmlrpc\.php$ - [R=410,L]
RewriteRule ^feed/?$ - [R=410,L]
RewriteRule ^comments/ - [R=410,L]
RewriteRule ^readme\.html$ - [R=410,L]
RewriteRule ^license\.txt$ - [R=410,L]
RewriteRule ^install\.php$ - [R=410,L]
RewriteRule ^(author|tag|projects|page|favorites|sites|product)/ - [R=410,L]
RewriteRule ^\d{4}/ - [R=410,L]
RewriteRule ^\d{4}/\d{2}/ - [R=410,L]

# --- Block public access to leads.json (customer PII, 2026-08-19) ---
<Files "leads.json">
  Require all denied
</Files>

